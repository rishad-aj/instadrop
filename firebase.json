{
  "hosting": {
    "target": "instadrop",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "server.js",
      "metadata.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/favicon.ico",
        "destination": "/icons/favicon.ico",
        "type": 301
      },
      {
        "source": "/Video",
        "destination": "/video",
        "type": 301
      },
      {
        "source": "/Reels",
        "destination": "/reels",
        "type": 301
      },
      {
        "source": "/Story",
        "destination": "/story",
        "type": 301
      },
      {
        "source": "/Highlights",
        "destination": "/highlights",
        "type": 301
      },
      {
        "source": "/Photo",
        "destination": "/photo",
        "type": 301
      },
      {
        "source": "/Audio",
        "destination": "/audio",
        "type": 301
      },
      {
        "source": "/DP",
        "destination": "/dp",
        "type": 301
      }
    ],

    "headers": [
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|ico|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
