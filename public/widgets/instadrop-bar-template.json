{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "default",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Image",
                  "url": "/images/logo.png",
                  "size": "small",
                  "altText": "Instadrop"
                }
              ],
              "verticalContentAlignment": "center"
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Instadrop",
                  "weight": "bolder",
                  "size": "medium",
                  "spacing": "none"
                },
                {
                  "type": "TextBlock",
                  "text": "${linkHint}",
                  "isSubtle": true,
                  "size": "small",
                  "spacing": "none",
                  "wrap": true
                }
              ],
              "verticalContentAlignment": "center"
            }
          ]
        },
        {
          "type": "Input.Text",
          "id": "link",
          "label": "Paste your link below",
          "placeholder": "${linkPlaceholder}",
          "isMultiline": false
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Execute",
              "title": "Paste",
              "verb": "paste",
              "data": { "action": "paste" }
            },
            {
              "type": "Action.Execute",
              "title": "Download",
              "verb": "open",
              "style": "positive",
              "data": { "action": "open" },
              "associatedInputs": "auto"
            }
          ]
        }
      ]
    }
  ]
}
