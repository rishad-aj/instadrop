{
  "name": "Instadrop — Free Instagram Media Downloader",
  "short_name": "Instadrop",
  "description": "Download Instagram reels, posts, carousels, profile pictures and story highlights. 100% free, ad-free, no login.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#fcfcfc",
  "theme_color": "#2563eb",
  "lang": "en",
  "categories": ["utilities", "photo", "music"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "images/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Instadrop desktop — Download Instagram reels, posts, profile pictures and audio in one click"
    },
    {
      "src": "images/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Instadrop mobile — Paste any Instagram link and download at original quality"
    }
  ],
  "shortcuts": [
    {
      "name": "Download a reel",
      "short_name": "Reels",
      "description": "Download an Instagram reel or post as MP4",
      "url": "/reels",
      "icons": [{ "src": "icons/shortcut-reel-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Grab a profile picture",
      "short_name": "DP",
      "description": "Fetch any profile picture at original size",
      "url": "/dp",
      "icons": [{ "src": "icons/shortcut-profile-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Extract audio",
      "short_name": "Audio",
      "description": "Turn a reel's soundtrack into an MP3 file",
      "url": "/audio",
      "icons": [{ "src": "icons/shortcut-audio-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Paste link to download",
      "short_name": "Paste",
      "description": "Open the quick-download widget and download in one tap",
      "url": "/widget.html?action=paste",
      "icons": [{ "src": "icons/shortcut-paste-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Instadrop quick download",
      "description": "Paste an Instagram link and jump straight to download.",
      "tag": "instadrop-bar",
      "template": "instadrop-bar-template",
      "ms_ac_template": "widgets/instadrop-bar-template.json",
      "data": "widgets/instadrop-bar-data.json",
      "type": "application/json",
      "screenshots": [
        { "src": "images/widget-screenshot.png", "sizes": "560x220", "type": "image/png", "label": "Instadrop quick download widget" }
      ],
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "auth": false,
      "update": 3600
    }
  ]
}
